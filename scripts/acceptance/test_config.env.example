# 快速验收测试配置文件
# 复制为 test_config.env 并填写实际配置

# ===================================
# 节点信息
# ===================================
NODE_IP="203.0.113.100"           # 节点公网 IP
NODE_NAME="测试节点"               # 节点名称 (可选)

# ===================================
# Mieru 配置
# ===================================
MIERU_TCP_PORTS="37065,48902,50900"   # Mieru TCP 端口 (逗号分隔)
MIERU_UDP_PORTS="40590"               # Mieru UDP 端口 (逗号分隔)

# ===================================
# AnyTLS 配置
# ===================================
ANYTLS_PORT="23112"                   # AnyTLS 端口
ANYTLS_PASSWORD="your_password"       # AnyTLS 密码

# ===================================
# ShadowTLS 配置
# ===================================
SHADOWTLS_PORT="40900"                # ShadowTLS 端口
SHADOWTLS_PASSWORD="your_password"    # ShadowTLS 密码
SHADOWTLS_HANDSHAKE="cloudflare.com"  # 握手站点

# ===================================
# NaïveProxy 配置
# ===================================
NAIVE_PORT="443"                      # NaïveProxy 端口 (默认 443)
NAIVE_DOMAIN="example.com"            # NaïveProxy 域名
NAIVE_USER="your_username"            # NaïveProxy 用户名
NAIVE_PASS="your_password"            # NaïveProxy 密码

# ===================================
# Manager API 配置
# ===================================
MANAGER_URL="http://manager-ip:8080"  # Manager 地址
SUBSCRIPTION_TOKEN="your_token"       # 订阅令牌

# ===================================
# 测试选项
# ===================================
TIMEOUT=5                             # 连接超时时间 (秒)
VERBOSE=false                         # 详细输出模式

# ===================================
# 示例配置 (来自实际测试)
# ===================================
# NODE_IP="203.0.113.100"
# MIERU_TCP_PORTS="37065,48902,50900"
# MIERU_UDP_PORTS="40590"
# ANYTLS_PORT="23112"
# SHADOWTLS_PORT="40900"
# NAIVE_PORT="443"
# MANAGER_URL="http://192.168.1.100:8080"
